# --- Provider Toggle ---
USE_OLLAMA=false

# --- Multi-Key Google API Configuration (5-Key Round-Robin Pool) ---
GOOGLE_API_KEY_1=your_google_api_key_1
GOOGLE_API_KEY_2=your_google_api_key_2
GOOGLE_API_KEY_3=your_google_api_key_3
GOOGLE_API_KEY_4=your_google_api_key_4
GOOGLE_API_KEY_5=your_google_api_key_5

# Default single key fallback
GOOGLE_API_KEY=your_google_api_key

GEMINI_MODEL=gemma-4-31b-it

# --- Model Parameters ---
TEMPERATURE=0.0

# --- Rate Limiting ---
RATE_LIMIT_PER_KEY_RPM=3
RATE_LIMIT_RPM=15

# API Timeouts
API_TIMEOUT=500
STAGE1_API_TIMEOUT=600
STAGE2_API_TIMEOUT=360
RETRY_WAIT_SECONDS=5

# --- Ollama Configuration (Local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_OCR_MODEL=qwen2.5-vl

# --- Image Preprocessing (OpenCV) ---
OCR_OUTPUT_DIR=ocr_output
PREPROCESS_DPI=200
PREPROCESS_DENOISE_H=10
PREPROCESS_DENOISE_TEMPLATE=5
PREPROCESS_DENOISE_SEARCH=21
PREPROCESS_SHARPEN=1.5
PREPROCESS_MORPH_K=2
PREPROCESS_SPLIT_OVERLAP_PCT=0.10
